digraph G { graph [rankdir=TB,bgcolor="transparent",pad=0.12,nodesep=0.30,ranksep=0.34,splines=polyline]; node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontsize=12,margin="0.16,0.10",color="#BDD3D0",fillcolor="#EDF5F3",fontcolor="#173338"]; edge [color="#48827D",arrowsize=0.68,fontname="DejaVu Sans",fontsize=10,fontcolor="#425D61"];
web [label="Vercel static frontend\nphoto → oriented JPEG ≤1600 px",fillcolor="#21494B",fontcolor="white",color="#21494B"];
pick [label="Browser probes /readyz\n15 s timeout per candidate"];
hf [label="Hugging Face Space\nGradio + FastAPI • primary"];
vc [label="Vercel Python function\nFastAPI • fallback"];
assets [label="GitHub model-assets\nSHA-256 pinned v1 archive",fillcolor="#21494B",fontcolor="white",color="#21494B"];
json [label="Selected host returns FrameResult\nBrowser draws boxes and available angles",fillcolor="#21494B",fontcolor="white",color="#21494B"];
web -> pick;
pick -> hf [label="first ready"];
pick -> vc [label="if primary unavailable"];
assets -> hf [style=dashed,label="cold load"];
assets -> vc [style=dashed,label="cold load"];
hf -> json;
vc -> json;
{rank=same;hf;vc};
{rank=same;pick;assets};
}